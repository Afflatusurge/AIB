---
import Layout from '../../../../layouts/Layout.astro';
import Footer from '../../../../components/Footer.astro';
import CaseDeskPage from '../../../../components/list-pages/CaseDeskPage.astro';
import { listCaseStudies } from '../../../../lib/content';
import { getPaginatedListing } from '../../../../lib/pagination';
import { useTranslations, getLangFromUrl } from '../../../../i18n/utils';

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPage = Number.parseInt(Astro.params.page || '1', 10);

const caseStudies = await listCaseStudies(lang as 'en' | 'zh' | 'ja');
const listing = getPaginatedListing(caseStudies, currentPage);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
---

<Layout title={`${t('nav.cases')} - ${t('site.name')}`}>
  <CaseDeskPage
    lang={lang}
    t={t}
    leadCase={listing.leadItem}
    cases={listing.entries}
    currentPage={listing.currentPage}
    totalPages={listing.totalPages}
  />
  <Footer lang={lang} />
</Layout>
