---
export const prerender = false;

const lang = Astro.params.lang || 'zh';
if (!['en', 'zh', 'ja'].includes(lang)) {
  return Astro.redirect('/zh/editorial/');
}

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set(
  'Content-Security-Policy',
  "default-src 'self'; connect-src 'self'; img-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Editorial Desk · AIandBusiness</title>
    <link rel="icon" href="/favicon.svg" />
    <style>
      :root {
        color-scheme: light;
        --ink: #171714;
        --muted: #6e6d64;
        --paper: #f5f1e8;
        --card: #fffdf8;
        --line: #d9d2c4;
        --yellow: #f4d84d;
        --green: #9bd7a5;
        --red: #ef806f;
        --blue: #9dc9e8;
        --shadow: 4px 4px 0 var(--ink);
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 5% 0%, rgba(244, 216, 77, .24), transparent 26rem),
          var(--paper);
        color: var(--ink);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      button, input, textarea, select { font: inherit; }
      button { cursor: pointer; }
      [hidden] { display: none !important; }

      .shell {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        padding: 28px 0 72px;
      }
      .masthead {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 22px;
        border-bottom: 2px solid var(--ink);
      }
      .brand { display: flex; align-items: center; gap: 12px; }
      .mark {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border: 2px solid var(--ink);
        background: var(--yellow);
        box-shadow: 3px 3px 0 var(--ink);
        font-weight: 900;
      }
      h1 { margin: 0; font-size: clamp(1.35rem, 3vw, 2rem); line-height: 1; }
      .eyebrow {
        margin: 0 0 6px;
        color: var(--muted);
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      .ghost {
        border: 1.5px solid var(--ink);
        background: transparent;
        padding: 9px 13px;
        font-weight: 750;
      }

      .login {
        width: min(520px, 100%);
        margin: 11vh auto 0;
        padding: 28px;
        border: 2px solid var(--ink);
        background: var(--card);
        box-shadow: var(--shadow);
      }
      .login h2 { margin: 0 0 10px; font-size: 1.65rem; }
      .login p { margin: 0 0 22px; color: var(--muted); line-height: 1.55; }
      .login-row { display: flex; gap: 10px; }
      .login input {
        min-width: 0;
        flex: 1;
        border: 1.5px solid var(--ink);
        background: #fff;
        padding: 12px 13px;
      }
      .primary {
        border: 1.5px solid var(--ink);
        background: var(--ink);
        color: white;
        padding: 11px 16px;
        font-weight: 800;
      }
      .message { min-height: 1.4em; margin-top: 14px !important; color: #a32d20 !important; }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin: 26px 0 20px;
      }
      .filters { display: flex; flex-wrap: wrap; gap: 8px; }
      .filter {
        border: 1.5px solid var(--ink);
        background: var(--card);
        padding: 9px 12px;
        font-weight: 750;
      }
      .filter.is-active { background: var(--yellow); box-shadow: 2px 2px 0 var(--ink); }
      .desk-status { color: var(--muted); font-size: .9rem; }
      .toolbar-actions { display: flex; align-items: center; gap: 10px; }
      .sync-button {
        border: 1.5px solid var(--ink);
        background: var(--blue);
        padding: 9px 12px;
        font-weight: 800;
        box-shadow: 2px 2px 0 var(--ink);
      }
      .sync-button:disabled { cursor: wait; opacity: .65; }

      .summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 20px;
      }
      .summary-card {
        padding: 14px 16px;
        border: 1.5px solid var(--ink);
        background: var(--card);
      }
      .summary-card strong { display: block; font-size: 1.7rem; }
      .summary-card span { color: var(--muted); font-size: .82rem; }

      .candidate-list { display: grid; gap: 18px; }
      .candidate {
        border: 2px solid var(--ink);
        background: var(--card);
        box-shadow: 3px 3px 0 rgba(23, 23, 20, .9);
        overflow: hidden;
      }
      .candidate-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border-bottom: 1.5px solid var(--ink);
        background: #f9f6ef;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        min-height: 25px;
        padding: 3px 9px;
        border: 1px solid var(--ink);
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .04em;
        text-transform: uppercase;
      }
      .priority-p0 { background: var(--red); }
      .priority-p1 { background: var(--yellow); }
      .priority-p2 { background: var(--blue); }
      .status-needs_review, .status-failed { background: var(--yellow); }
      .status-published { background: var(--green); }
      .status-rejected { background: #ddd7cc; }
      .candidate-date { margin-left: auto; color: var(--muted); font-size: .78rem; }
      .candidate-body { padding: 20px; }
      .source-line { margin: 0 0 8px; color: var(--muted); font-size: .82rem; }
      .source-line a { color: inherit; font-weight: 750; }
      .candidate h2 { margin: 0 0 10px; font-size: clamp(1.2rem, 2.6vw, 1.65rem); line-height: 1.24; }
      .summary-text { max-width: 82ch; margin: 0; color: #45443e; line-height: 1.6; }
      .facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 16px;
      }
      .fact {
        min-width: 0;
        padding: 12px;
        border: 1px solid var(--line);
        background: #fbf8f1;
      }
      .fact-label {
        margin-bottom: 5px;
        color: var(--muted);
        font-size: .7rem;
        font-weight: 850;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .fact-value { font-size: .88rem; line-height: 1.45; overflow-wrap: anywhere; }
      .review-note {
        width: 100%;
        min-height: 74px;
        margin-top: 16px;
        resize: vertical;
        border: 1.5px solid var(--ink);
        background: white;
        padding: 10px 12px;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 9px;
        margin-top: 12px;
      }
      .approve, .reject, .open-brief {
        border: 1.5px solid var(--ink);
        padding: 9px 13px;
        color: var(--ink);
        font-weight: 800;
        text-decoration: none;
      }
      .approve { background: var(--green); }
      .reject { background: var(--red); }
      .open-brief { background: var(--blue); }
      button:disabled { cursor: wait; opacity: .55; }
      .action-status { color: var(--muted); font-size: .82rem; }
      .empty {
        padding: 48px 24px;
        border: 2px dashed var(--line);
        background: rgba(255, 253, 248, .62);
        text-align: center;
        color: var(--muted);
      }

      @media (max-width: 700px) {
        .shell { width: min(100% - 20px, 1180px); padding-top: 16px; }
        .masthead { align-items: flex-start; }
        .login { margin-top: 8vh; padding: 20px; }
        .login-row { flex-direction: column; }
        .summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .facts { grid-template-columns: 1fr; }
        .candidate-head { align-items: flex-start; }
        .candidate-date { width: 100%; margin-left: 0; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="masthead">
        <div class="brand">
          <span class="mark">A!</span>
          <div>
            <p class="eyebrow">Private editorial console</p>
            <h1>AIandBusiness Editorial Desk</h1>
          </div>
        </div>
        <button id="logout" class="ghost" type="button" hidden>退出</button>
      </header>

      <section id="login-panel" class="login">
        <h2>编辑登录</h2>
        <p>输入编辑访问令牌。令牌只保存在当前浏览器标签页，关闭标签页后自动清除。</p>
        <form id="login-form" class="login-row">
          <input
            id="editor-token"
            type="password"
            name="token"
            placeholder="aib_ed_…"
            autocomplete="current-password"
            required
          />
          <button class="primary" type="submit">进入审核台</button>
        </form>
        <p id="login-message" class="message" role="alert"></p>
      </section>

      <section id="desk" hidden>
        <div class="toolbar">
          <div class="filters" aria-label="候选状态">
            <button class="filter is-active" data-status="all" type="button">全部</button>
            <button class="filter" data-status="needs_review" type="button">待审核</button>
            <button class="filter" data-status="failed" type="button">失败</button>
            <button class="filter" data-status="published" type="button">已发布</button>
            <button class="filter" data-status="rejected" type="button">已拒绝</button>
          </div>
          <div class="toolbar-actions">
            <button id="sync-content" class="sync-button" type="button">同步 Notion 栏目</button>
            <div id="desk-status" class="desk-status" aria-live="polite">准备加载…</div>
          </div>
        </div>

        <div id="summary" class="summary"></div>
        <div id="candidate-list" class="candidate-list"></div>
      </section>
    </main>

    <script>
      const TOKEN_KEY = 'aib-editor-token';
      const endpoint = '/api/editorial/candidates';
      const loginPanel = document.querySelector('#login-panel');
      const loginForm = document.querySelector('#login-form');
      const tokenInput = document.querySelector('#editor-token');
      const loginMessage = document.querySelector('#login-message');
      const desk = document.querySelector('#desk');
      const logoutButton = document.querySelector('#logout');
      const list = document.querySelector('#candidate-list');
      const summary = document.querySelector('#summary');
      const deskStatus = document.querySelector('#desk-status');
      const syncButton = document.querySelector('#sync-content');
      const filterButtons = Array.from(document.querySelectorAll('[data-status]'));

      let token = window.sessionStorage.getItem(TOKEN_KEY) || '';
      let currentStatus = 'all';
      let candidates = [];

      const text = (tag, value, className = '') => {
        const node = document.createElement(tag);
        if (className) node.className = className;
        node.textContent = String(value ?? '');
        return node;
      };

      const prettyStatus = (status) => ({
        needs_review: '待审核',
        researched: '已研究',
        published: '已发布',
        rejected: '已拒绝',
        failed: '生成失败',
        discovered: '已发现',
        drafted: '草稿',
        approved: '已批准',
      })[status] || status;

      const formatDate = (value) => {
        if (!value) return '—';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return String(value);
        return new Intl.DateTimeFormat('zh-CN', {
          dateStyle: 'medium',
          timeStyle: 'short',
          timeZone: 'America/Los_Angeles',
        }).format(date);
      };

      const safeUrl = (value) => {
        try {
          const url = new URL(value);
          return ['https:', 'http:'].includes(url.protocol) ? url.href : '';
        } catch {
          return '';
        }
      };

      const api = async (path = '', options = {}) => {
        const response = await fetch(`${endpoint}${path}`, {
          ...options,
          headers: {
            accept: 'application/json',
            authorization: `Bearer ${token}`,
            ...(options.body ? { 'content-type': 'application/json' } : {}),
            ...(options.headers || {}),
          },
          cache: 'no-store',
        });
        const payload = await response.json().catch(() => ({ ok: false, error: '响应格式错误' }));
        if (response.status === 401) {
          window.sessionStorage.removeItem(TOKEN_KEY);
          token = '';
          showLogin('访问令牌无效或已失效。');
        }
        if (!response.ok || !payload.ok) {
          throw new Error(payload.error || `请求失败 (${response.status})`);
        }
        return payload;
      };

      const showLogin = (message = '') => {
        loginPanel.hidden = false;
        desk.hidden = true;
        logoutButton.hidden = true;
        loginMessage.textContent = message;
        tokenInput.value = '';
        tokenInput.focus();
      };

      const showDesk = () => {
        loginPanel.hidden = true;
        desk.hidden = false;
        logoutButton.hidden = false;
      };

      const factValue = (value) => {
        if (Array.isArray(value)) return value.filter(Boolean).join(' · ');
        if (value && typeof value === 'object') return JSON.stringify(value);
        return value || '—';
      };

      const renderSummary = () => {
        summary.replaceChildren();
        const counts = {
          total: candidates.length,
          needs_review: candidates.filter((item) => item.status === 'needs_review').length,
          failed: candidates.filter((item) => item.status === 'failed').length,
          published: candidates.filter((item) => item.status === 'published').length,
        };
        [
          ['当前列表', counts.total],
          ['待审核', counts.needs_review],
          ['失败', counts.failed],
          ['已发布', counts.published],
        ].forEach(([label, count]) => {
          const card = document.createElement('div');
          card.className = 'summary-card';
          card.append(text('strong', count), text('span', label));
          summary.append(card);
        });
      };

      const addFact = (container, label, value) => {
        const card = document.createElement('div');
        card.className = 'fact';
        card.append(
          text('div', label, 'fact-label'),
          text('div', factValue(value), 'fact-value'),
        );
        container.append(card);
      };

      const runAction = async (candidate, action, note, card) => {
        if (action === 'reject' && !note.trim()) {
          card.querySelector('.action-status').textContent = '拒绝时必须填写原因。';
          return;
        }
        const verb = action === 'approve' ? '批准并发布' : '拒绝';
        if (!window.confirm(`确认${verb}“${candidate.title}”？`)) return;

        const buttons = Array.from(card.querySelectorAll('button'));
        buttons.forEach((button) => { button.disabled = true; });
        const status = card.querySelector('.action-status');
        status.textContent =
          action === 'approve' ? '正在生成、质量检查并发布，可能需要几十秒…' : '正在记录拒绝决定…';
        try {
          const payload = await api('', {
            method: 'POST',
            body: JSON.stringify({
              candidateId: candidate.id,
              action,
              note: note.trim(),
            }),
          });
          status.textContent =
            action === 'approve'
              ? `已发布：${payload.result.slug}`
              : '已拒绝并写入审核记录。';
          await loadCandidates();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : String(error);
          buttons.forEach((button) => { button.disabled = false; });
        }
      };

      const renderCandidate = (candidate) => {
        const card = document.createElement('article');
        card.className = 'candidate';

        const head = document.createElement('div');
        head.className = 'candidate-head';
        head.append(
          text('span', candidate.priority, `badge priority-${String(candidate.priority).toLowerCase()}`),
          text('span', prettyStatus(candidate.status), `badge status-${candidate.status}`),
          text('span', candidate.eventType || 'release', 'badge'),
          text('span', `评分 ${candidate.totalScore ?? '—'}`, 'badge'),
          text('span', formatDate(candidate.sourcePublishedAt), 'candidate-date'),
        );

        const body = document.createElement('div');
        body.className = 'candidate-body';
        const sourceLine = document.createElement('p');
        sourceLine.className = 'source-line';
        sourceLine.append(document.createTextNode(`${candidate.sourceName} · `));
        const sourceHref = safeUrl(candidate.sourceUrl);
        if (sourceHref) {
          const sourceLink = document.createElement('a');
          sourceLink.href = sourceHref;
          sourceLink.target = '_blank';
          sourceLink.rel = 'noopener noreferrer';
          sourceLink.textContent = '查看原文 ↗';
          sourceLine.append(sourceLink);
        }
        body.append(sourceLine, text('h2', candidate.title), text('p', candidate.summary, 'summary-text'));

        const facts = document.createElement('div');
        facts.className = 'facts';
        addFact(facts, '产品', candidate.factSheet?.products);
        addFact(facts, '商业影响', candidate.factSheet?.businessImpact);
        addFact(facts, '建议动作', candidate.factSheet?.possibleActions);
        addFact(facts, '注意事项', candidate.factSheet?.caveats || candidate.flags);
        body.append(facts);

        if (candidate.lastReview) {
          body.append(
            text(
              'p',
              `最近操作：${candidate.lastReview.action} · ${candidate.lastReview.actor} · ${formatDate(candidate.lastReview.createdAt)}${candidate.lastReview.note ? ` · ${candidate.lastReview.note}` : ''}`,
              'source-line',
            ),
          );
        }

        const note = document.createElement('textarea');
        note.className = 'review-note';
        note.placeholder = '编辑备注；拒绝时必须填写原因。';
        note.maxLength = 500;

        const actions = document.createElement('div');
        actions.className = 'actions';
        if (!['published', 'rejected'].includes(candidate.status)) {
          body.append(note);
          const approve = text('button', '批准并发布', 'approve');
          approve.type = 'button';
          approve.addEventListener('click', () => runAction(candidate, 'approve', note.value, card));
          const reject = text('button', '拒绝', 'reject');
          reject.type = 'button';
          reject.addEventListener('click', () => runAction(candidate, 'reject', note.value, card));
          actions.append(approve, reject);
        }
        if (candidate.publishedSlug) {
          const link = text('a', '打开已发布简报 ↗', 'open-brief');
          link.href = `/zh/daily/${encodeURIComponent(candidate.publishedSlug)}/`;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          actions.append(link);
        }
        actions.append(text('span', '', 'action-status'));
        body.append(actions);
        card.append(head, body);
        return card;
      };

      const renderCandidates = () => {
        list.replaceChildren();
        renderSummary();
        if (!candidates.length) {
          list.append(text('div', '这个状态下暂无候选新闻。', 'empty'));
          return;
        }
        candidates.forEach((candidate) => list.append(renderCandidate(candidate)));
      };

      const loadCandidates = async () => {
        deskStatus.textContent = '正在加载…';
        try {
          const payload = await api(`?status=${encodeURIComponent(currentStatus)}&limit=100`);
          candidates = payload.candidates || [];
          showDesk();
          renderCandidates();
          deskStatus.textContent = `${payload.editor} · ${candidates.length} 条 · ${formatDate(new Date().toISOString())}`;
        } catch (error) {
          if (token) {
            deskStatus.textContent = error instanceof Error ? error.message : String(error);
          }
        }
      };

      const syncNotionContent = async () => {
        syncButton.disabled = true;
        const originalLabel = syncButton.textContent;
        syncButton.textContent = '正在同步…';
        deskStatus.textContent = '正在把工具、案例和 Playbooks 同步到发布数据库…';
        try {
          const response = await fetch('/api/editorial/content-sync', {
            method: 'POST',
            headers: {
              accept: 'application/json',
              authorization: `Bearer ${token}`,
              'content-type': 'application/json',
            },
            body: JSON.stringify({}),
            cache: 'no-store',
          });
          const payload = await response.json().catch(() => ({ ok: false, error: '响应格式错误' }));
          if (response.status === 401) {
            window.sessionStorage.removeItem(TOKEN_KEY);
            token = '';
            showLogin('访问令牌无效或已失效。');
            return;
          }
          if (!response.ok || !payload.ok) {
            throw new Error(payload.error || `同步失败 (${response.status})`);
          }
          const reports = payload.reports || [];
          const changed = reports.reduce((sum, item) => sum + (item.changed || 0), 0);
          const failed = reports.reduce((sum, item) => sum + (item.failed || 0), 0);
          deskStatus.textContent = `栏目同步完成 · 更新 ${changed} 条${failed ? ` · 失败 ${failed} 条` : ''} · ${formatDate(new Date().toISOString())}`;
        } catch (error) {
          deskStatus.textContent = error instanceof Error ? error.message : String(error);
        } finally {
          syncButton.disabled = false;
          syncButton.textContent = originalLabel;
        }
      };

      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        loginMessage.textContent = '正在验证…';
        token = tokenInput.value.trim();
        if (!token) return;
        try {
          await loadCandidates();
          if (token) {
            window.sessionStorage.setItem(TOKEN_KEY, token);
            loginMessage.textContent = '';
          }
        } catch {
          // loadCandidates already renders the appropriate error state.
        }
      });

      logoutButton.addEventListener('click', () => {
        window.sessionStorage.removeItem(TOKEN_KEY);
        token = '';
        candidates = [];
        showLogin();
      });

      filterButtons.forEach((button) => {
        button.addEventListener('click', async () => {
          currentStatus = button.dataset.status || 'all';
          filterButtons.forEach((item) => item.classList.toggle('is-active', item === button));
          await loadCandidates();
        });
      });

      syncButton.addEventListener('click', syncNotionContent);

      if (token) {
        loadCandidates();
      } else {
        showLogin();
      }
    </script>
  </body>
</html>
