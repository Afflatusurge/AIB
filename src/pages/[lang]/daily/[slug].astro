---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import { getBriefBySlug, listPublishedBriefs } from '../../../lib/supabase';
import { useTranslations, getLangFromUrl } from '../../../i18n/utils';

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const slug = String(Astro.params.slug || '').trim();

if (!slug) return Astro.redirect(`/${lang}/daily/`);

const brief = await getBriefBySlug(slug, lang as 'en' | 'zh' | 'ja');
if (!brief) return new Response('Not found', { status: 404 });

const allBriefs = await listPublishedBriefs(lang as 'en' | 'zh' | 'ja', 120);
const idx = allBriefs.findIndex((b) => b.id === brief.id);
const prevBrief = idx > 0 ? allBriefs[idx - 1] : null;
const nextBrief = idx >= 0 && idx < allBriefs.length - 1 ? allBriefs[idx + 1] : null;
const relatedBriefs = allBriefs.filter((b) => b.id !== brief.id).slice(0, 3);

const bodyHtml = brief.bodyHtml || '';
const headingMatches = Array.from(bodyHtml.matchAll(/<h2>(.*?)<\/h2>/g));
const headingItems = headingMatches.map((match, i) => ({
  id: `section-${i + 1}`,
  title: match[1].replace(/<[^>]+>/g, ''),
}));
const headingQueue = [...headingItems];
const processedBodyHtml = headingMatches.length
  ? bodyHtml.replace(/<h2>/g, () => {
      const h = headingQueue.shift();
      return h ? `<h2 id="${h.id}">` : '<h2>';
    })
  : bodyHtml;
const hasBodyContent = !!processedBodyHtml.trim();

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
);

const uiText = {
  signal: lang === 'zh' ? '信号' : lang === 'ja' ? 'シグナル' : 'Signal',
  impact: lang === 'zh' ? '影响' : lang === 'ja' ? '影響' : 'Impact',
  whyItMatters: lang === 'zh' ? '为什么重要' : lang === 'ja' ? 'なぜ重要か' : 'Why it matters',
  editorsNote: lang === 'zh' ? '编辑注记' : lang === 'ja' ? '編集メモ' : 'Editor’s note',
  whyNow: lang === 'zh' ? '为什么是现在' : lang === 'ja' ? 'なぜ今か' : 'Why now',
  thisBrief: lang === 'zh' ? '本篇简报' : lang === 'ja' ? 'このブリーフ' : 'This brief',
  onThisPage: lang === 'zh' ? '本页目录' : lang === 'ja' ? 'このページ' : 'On this page',
  moreFromDaily: lang === 'zh' ? '更多每日简报' : lang === 'ja' ? 'さらに読むデイリーブリーフ' : 'More from daily',
  continueReading: lang === 'zh' ? '继续阅读' : lang === 'ja' ? '続きを読む' : 'Continue reading',
  summary: lang === 'zh' ? '摘要' : lang === 'ja' ? '要約' : 'Summary',
  editorialNote: lang === 'zh' ? '编辑说明' : lang === 'ja' ? '編集コメント' : 'Editorial note',
  source: lang === 'zh' ? '来源' : lang === 'ja' ? '参照元' : 'Source',
  sourceType: lang === 'zh' ? '来源类型' : lang === 'ja' ? '情報源の種類' : 'Source type',
  verification: lang === 'zh' ? '核实状态' : lang === 'ja' ? '確認状況' : 'Verification',
  officialSource: lang === 'zh' ? '官方来源' : lang === 'ja' ? '公式情報源' : 'Official source',
  release: lang === 'zh' ? '重要更新' : lang === 'ja' ? '重要アップデート' : 'Major update',
  sourcePublished: lang === 'zh' ? '原文发布' : lang === 'ja' ? '元記事公開' : 'Source published',
  actionNow: lang === 'zh' ? '现在怎么做' : lang === 'ja' ? '今やること' : 'What to do now',
  watchNext: lang === 'zh' ? '接下来观察' : lang === 'ja' ? '次に見ること' : 'What to watch next',
  caveat: lang === 'zh' ? '边界与口径' : lang === 'ja' ? '留意点' : 'Caveat',
  readOriginalCoverage: lang === 'zh' ? '查看原始报道 →' : lang === 'ja' ? '元記事を読む →' : 'Read the original coverage →',
} as const;

const summaryCards = [
  { label: uiText.signal, value: brief.category || 'AI' },
  { label: uiText.impact, value: brief.impact || 'Notable' },
  {
    label: uiText.whyItMatters,
    value: brief.whyItMatters || brief.commentary || brief.snippet ||
      (lang === 'zh' ? '关键不是消息本身，而是它会改变独立创业者接下来该关注什么。'
        : lang === 'ja' ? '重要なのはニュースそのものではなく、次に何へ注意を向けるべきかが変わる点です。'
          : 'What matters is not the headline alone, but what it changes for solo builders next.'),
  },
];
const recommendationIntro = lang === 'zh'
  ? '从当前信号继续延伸，看更多值得判断的更新。'
  : lang === 'ja'
    ? 'いまのシグナルから、次に読むべき更新へつなげます。'
    : 'Move from this signal into adjacent updates worth your attention.';

const sourceKindLabel = brief.sourceKind === 'official_release'
  ? uiText.officialSource
  : brief.sourceKind === 'primary_research'
    ? (lang === 'zh' ? '一手研究' : lang === 'ja' ? '一次研究' : 'Primary research')
    : brief.sourceKind === 'specialist_media'
      ? (lang === 'zh' ? '专业媒体' : lang === 'ja' ? '専門メディア' : 'Specialist media')
      : brief.sourceKind === 'media'
        ? (lang === 'zh' ? '媒体报道' : lang === 'ja' ? 'メディア報道' : 'Media coverage')
        : brief.sourceKind;

const verificationLabel = brief.verificationStatus === 'official_release_verified'
  ? (lang === 'zh' ? '官方发布已核实' : lang === 'ja' ? '公式リリース確認済み' : 'Official release verified')
  : brief.verificationStatus === 'source_verified'
    ? (lang === 'zh' ? '来源已核实' : lang === 'ja' ? '情報源確認済み' : 'Source verified')
    : brief.verificationStatus === 'legacy_unverified'
      ? (lang === 'zh' ? '历史内容，尚未核实' : lang === 'ja' ? '過去記事・未確認' : 'Legacy content, unverified')
      : brief.verificationStatus;
---

<Layout title={`${brief.title} - ${t('site.name')}`} description={brief.snippet || brief.whyItMatters || undefined}>
  <section class="page-section">
    <div class="container">
      <article class="article-shell fade-in">
        <header class="article-hero">
          <div class="article-tags">
            <span class="card-badge">{brief.category || 'AI'}</span>
            {brief.impact && <span class="card-badge impact-major">{brief.impact}</span>}
            {brief.contentKind === 'release' && <span class="card-badge release-badge">{uiText.release}</span>}
            {brief.sourceKind === 'official_release' && <span class="card-badge source-badge">{uiText.officialSource}</span>}
          </div>
          <h1>{brief.title}</h1>
          {brief.snippet && <p class="article-dek">{brief.snippet}</p>}
          <div class="article-meta">
            <time datetime={brief.date}>{brief.date}</time>
            <span>·</span>
            <span>{brief.category}</span>
            {brief.sourceName && <><span>·</span><span>{brief.sourceName}</span></>}
            {brief.sourcePublishedDate && (
              <><span>·</span><span>{uiText.sourcePublished} {brief.sourcePublishedDate}</span></>
            )}
          </div>
          <div class="article-lead-grid">
            <div class="article-lead-note">
              <p class="article-lead-label">{uiText.editorsNote}</p>
              <p>{brief.commentary || brief.whyItMatters || brief.snippet}</p>
            </div>
            <div class="article-lead-note alt">
              <p class="article-lead-label">{uiText.whyNow}</p>
              <p>{brief.whyItMatters || brief.snippet || brief.commentary}</p>
            </div>
          </div>
        </header>

        <div class="article-layout">
          <aside class="article-rail">
            <div class="rail-card">
              <p class="rail-label">{uiText.thisBrief}</p>
              <ul class="rail-list">
                <li><strong>{lang === 'zh' ? '栏目' : lang === 'ja' ? '欄' : 'Desk'}</strong><span>{t('nav.daily')}</span></li>
                <li><strong>{lang === 'zh' ? '类别' : lang === 'ja' ? '分類' : 'Category'}</strong><span>{brief.category || 'AI'}</span></li>
                <li><strong>{lang === 'zh' ? '影响' : lang === 'ja' ? '影響' : 'Impact'}</strong><span>{brief.impact || 'Notable'}</span></li>
                {sourceKindLabel && <li><strong>{uiText.sourceType}</strong><span>{sourceKindLabel}</span></li>}
                {verificationLabel && <li><strong>{uiText.verification}</strong><span>{verificationLabel}</span></li>}
              </ul>
              {brief.sourceUrl && (
                <a class="rail-link" href={brief.sourceUrl} target="_blank" rel="noopener">
                  {lang === 'zh' ? '查看原始来源 →' : lang === 'ja' ? '元ソースを見る →' : 'View source →'}
                </a>
              )}
            </div>
            {headingItems.length > 0 && (
              <div class="rail-card">
                <p class="rail-label">{uiText.onThisPage}</p>
                <ul class="related-list">
                  {headingItems.map((item) => (
                    <li><a href={`#${item.id}`}>{item.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
            {relatedBriefs.length > 0 && (
              <div class="rail-card">
                <p class="rail-label">{uiText.moreFromDaily}</p>
                <ul class="related-list">
                  {relatedBriefs.map((item) => (
                    <li><a href={`/${lang}/daily/${item.slug || item.id}/`}>{item.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </aside>

          <div class="article-column">
            {(sourceKindLabel || verificationLabel) && (
              <div class="article-trust-strip">
                {sourceKindLabel && <span>{sourceKindLabel}</span>}
                {brief.sourceReliability && <span>{lang === 'zh' ? '来源等级' : lang === 'ja' ? '情報源レベル' : 'Source tier'} {brief.sourceReliability}</span>}
                {verificationLabel && <span>{uiText.verification}: {verificationLabel}</span>}
              </div>
            )}
            <div class="summary-grid">
              {summaryCards.map((card) => (
                <section class="summary-card">
                  <p class="summary-label">{card.label}</p>
                  <div class="summary-value">{card.value}</div>
                </section>
              ))}
            </div>
            <div class="article-body">
              {hasBodyContent ? (
                <Fragment set:html={processedBodyHtml} />
              ) : (
                <>
                  {brief.snippet && (
                    <>
                      <h2>{uiText.summary}</h2>
                      <p>{brief.snippet}</p>
                    </>
                  )}
                  {brief.commentary && (
                    <>
                      <h2>{uiText.editorialNote}</h2>
                      <p>{brief.commentary}</p>
                    </>
                  )}
                  {brief.whyItMatters && (
                    <>
                      <h2>{uiText.whyItMatters}</h2>
                      <p>{brief.whyItMatters}</p>
                    </>
                  )}
                  {brief.sourceUrl && (
                    <>
                      <h2>{uiText.source}</h2>
                      <p>
                        <a href={brief.sourceUrl} target="_blank" rel="noopener">
                          {uiText.readOriginalCoverage}
                        </a>
                      </p>
                    </>
                  )}
                </>
              )}
            </div>
            {(brief.actionNow || brief.watchNext || brief.caveat) && (
              <div class="article-decision-grid">
                {brief.actionNow && (
                  <section class="article-decision-card">
                    <p class="summary-label">{uiText.actionNow}</p>
                    <p>{brief.actionNow}</p>
                  </section>
                )}
                {brief.watchNext && (
                  <section class="article-decision-card">
                    <p class="summary-label">{uiText.watchNext}</p>
                    <p>{brief.watchNext}</p>
                  </section>
                )}
                {brief.caveat && (
                  <section class="article-decision-card caveat">
                    <p class="summary-label">{uiText.caveat}</p>
                    <p>{brief.caveat}</p>
                  </section>
                )}
              </div>
            )}
          </div>
        </div>

        {(prevBrief || nextBrief) && (
          <div class="article-nav">
            {prevBrief ? (
              <a href={`/${lang}/daily/${prevBrief.slug || prevBrief.id}/`} class="prev">
                <div class="nav-label">← {lang === 'zh' ? '上一篇' : lang === 'ja' ? '前へ' : 'Previous'}</div>
                <div class="nav-title">{prevBrief.title}</div>
              </a>
            ) : <div />}
            {nextBrief ? (
              <a href={`/${lang}/daily/${nextBrief.slug || nextBrief.id}/`} class="next">
                <div class="nav-label">{lang === 'zh' ? '下一篇' : lang === 'ja' ? '次へ' : 'Next'} →</div>
                <div class="nav-title">{nextBrief.title}</div>
              </a>
            ) : <div />}
          </div>
        )}

        {relatedBriefs.length > 0 && (
          <section class="article-recommendations">
            <div class="article-recommendations-head">
              <p class="article-recommendations-kicker">{uiText.continueReading}</p>
              <h2>{lang === 'zh' ? '更多今日信号' : lang === 'ja' ? 'さらに読む今日のシグナル' : 'More daily signals'}</h2>
              <p>{recommendationIntro}</p>
            </div>
            <div class="article-recommendations-grid">
              {relatedBriefs.map((item) => (
                <a href={`/${lang}/daily/${item.slug || item.id}/`} class="article-rec-card">
                  <div class="article-rec-meta">
                    <span>{item.category || 'AI'}</span>
                    <span>{item.impact || 'Notable'}</span>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.whyItMatters || item.commentary || item.snippet}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="article-back">
          <a href={`/${lang}/daily/`}>← {t('nav.daily')}</a>
        </div>
      </article>
    </div>
  </section>
  <Footer lang={lang} />
</Layout>
