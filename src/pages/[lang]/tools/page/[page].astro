---
import Layout from '../../../../layouts/Layout.astro';
import Footer from '../../../../components/Footer.astro';
import ToolDeskPage from '../../../../components/list-pages/ToolDeskPage.astro';
import { listToolReviews } from '../../../../lib/content';
import { getPaginatedListing } from '../../../../lib/pagination';
import { useTranslations, getLangFromUrl } from '../../../../i18n/utils';

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPage = Number.parseInt(Astro.params.page || '1', 10);

const toolReviews = await listToolReviews(lang as 'en' | 'zh' | 'ja');
const listing = getPaginatedListing(toolReviews, currentPage);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
---

<Layout title={`${t('nav.tools')} - ${t('site.name')}`}>
  <ToolDeskPage
    lang={lang}
    t={t}
    leadTool={listing.leadItem}
    tools={listing.entries}
    currentPage={listing.currentPage}
    totalPages={listing.totalPages}
  />
  <Footer lang={lang} />
</Layout>
