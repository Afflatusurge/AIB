---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string[] | string;
  ogImage?: string;
}

const { title, description = 'AI Solopreneur Guide - Daily briefs, tool reviews, and case studies for building an AI-powered one-person business.', keywords, ogImage } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const keywordContent = Array.isArray(keywords) ? keywords.join(', ') : keywords;
const GA_MEASUREMENT_ID = 'G-KRMNDMBYMK';
const ctaLabel = lang === 'zh' ? '看今日简报' : lang === 'ja' ? 'ブリーフを読む' : "Read today's brief";
const currentLanguageLabel = lang === 'zh' ? '中文' : lang === 'ja' ? '日本語' : 'EN';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const languages = ['en', 'ja', 'zh'];
const pathWithoutLang = Astro.url.pathname
	.split('/')
	.filter((segment) => segment && !['en', 'ja', 'zh'].includes(segment))
	.join('/');

const isActive = (prefix: string) =>
  prefix === `/${lang}/`
    ? Astro.url.pathname === prefix
    : Astro.url.pathname.startsWith(prefix);
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		{keywordContent && <meta name="keywords" content={keywordContent} />}
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-64x64.png" sizes="64x64" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<!-- Hreflang Alternate Links -->
		{languages.map((langCode) => {
			const alternateUrl = new URL(`/${langCode}${pathWithoutLang ? '/' + pathWithoutLang : '/'}`, Astro.site);
			const langAttribute = langCode === 'zh' ? 'zh-CN' : langCode === 'ja' ? 'ja-JP' : 'en-US';
			return <link rel="alternate" hreflang={langAttribute} href={alternateUrl} />;
		})}
		<link rel="alternate" hreflang="x-default" href={new URL('/en/', Astro.site)} />
	</head>
	<body class={`lang-${lang}`}>
        <header class="site-nav">
            <a href={`/${lang}/`} class="logo">
              <span class="logo-mark">A!</span>
              <span class="logo-name">AIandBusiness</span>
            </a>
            <nav class="nav-links" aria-label="Primary">
                <a href={`/${lang}/`} class={isActive(`/${lang}/`) ? 'active' : ''}>
                    {t('nav.home')}
                </a>
                <a href={`/${lang}/daily/`} class={isActive(`/${lang}/daily`) ? 'active' : ''}>
                    {t('nav.daily')}
                </a>
                <a href={`/${lang}/tools/`} class={isActive(`/${lang}/tools`) ? 'active' : ''}>
                    {t('nav.tools')}
                </a>
                <a href={`/${lang}/playbooks/`} class={isActive(`/${lang}/playbooks`) ? 'active' : ''}>
                    {t('nav.playbooks')}
                </a>
                <a href={`/${lang}/cases/`} class={isActive(`/${lang}/cases`) ? 'active' : ''}>
                    {t('nav.cases')}
                </a>
            </nav>
            <div class="nav-right">
              <details class="lang-wrap" aria-label="Language switcher">
                <summary class="lang-btn">
                  <span aria-hidden="true">🌐</span>
                  <span class="lang-current">{currentLanguageLabel}</span>
                  <span class="caret" aria-hidden="true">▾</span>
                </summary>
                <div class="lang-menu">
                  <a href={`/en${pathWithoutLang ? '/' + pathWithoutLang : '/'}`} class={`lang-opt ${lang === 'en' ? 'selected' : ''}`}>English {lang === 'en' && <span class="check">✓</span>}</a>
                  <a href={`/zh${pathWithoutLang ? '/' + pathWithoutLang : '/'}`} class={`lang-opt ${lang === 'zh' ? 'selected' : ''}`}>中文 {lang === 'zh' && <span class="check">✓</span>}</a>
                  <a href={`/ja${pathWithoutLang ? '/' + pathWithoutLang : '/'}`} class={`lang-opt ${lang === 'ja' ? 'selected' : ''}`}>日本語 {lang === 'ja' && <span class="check">✓</span>}</a>
                </div>
              </details>
              <a href={`/${lang}/daily/`} class="nav-cta">{ctaLabel}</a>
            </div>
        </header>
		<main>
			<slot />
		</main>
    <ConsentBanner lang={lang} />
		<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
			// Google Consent Mode v2 (advanced).
			//
			// gtag.js loads for everyone, but starts with analytics_storage DENIED:
			// no cookies are written and only anonymous, cookieless pings are sent,
			// which GA4 uses for behavioral modeling. When the visitor accepts the
			// consent banner, we upgrade to granted and full measurement begins.
			// Ad-related signals stay denied permanently — this site runs no ads.
			(() => {
				const storageKey = 'aib-analytics-consent';
				const measurementId = GA_MEASUREMENT_ID;

				window.dataLayer = window.dataLayer || [];
				function gtag() { window.dataLayer.push(arguments); }
				window.gtag = window.gtag || gtag;

				const stored = window.localStorage.getItem(storageKey);
				const granted = stored === 'yes';

				// Consent defaults MUST be set before the config call.
				window.gtag('consent', 'default', {
					ad_storage: 'denied',
					ad_user_data: 'denied',
					ad_personalization: 'denied',
					analytics_storage: granted ? 'granted' : 'denied',
				});
				// Preserve attribution through URL instead of cookies while denied.
				window.gtag('set', 'url_passthrough', true);

				window.gtag('js', new Date());
				window.gtag('config', measurementId, { anonymize_ip: true });

				const script = document.createElement('script');
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
				document.head.appendChild(script);

				const getCookieNames = () =>
					document.cookie
						.split(';')
						.map((chunk) => chunk.trim().split('=')[0])
						.filter(Boolean);

				const clearCookie = (name) => {
					const hostname = window.location.hostname;
					const parts = hostname.split('.').filter(Boolean);
					const rootDomain = parts.length >= 2 ? `.${parts.slice(-2).join('.')}` : '';
					const domains = [undefined, hostname, `.${hostname}`, rootDomain].filter(Boolean);

					domains.forEach((domain) => {
						document.cookie = `${name}=; Max-Age=0; path=/; domain=${domain}; SameSite=Lax`;
					});

					document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
				};

				window.addEventListener('aib:consent-updated', (event) => {
					const allowed = !!event.detail?.analytics;
					window.gtag('consent', 'update', {
						analytics_storage: allowed ? 'granted' : 'denied',
					});
					if (!allowed) {
						// Withdrawn consent: remove any GA cookies set while granted.
						getCookieNames()
							.filter((name) => name === '_ga' || name.startsWith('_ga_') || name === '_gid' || name.startsWith('_gat'))
							.forEach(clearCookie);
					}
				});
			})();
		</script>
		<script is:inline>
			(() => {
				const setupTabGroup = (group) => {
				const triggers = Array.from(group.querySelectorAll('.article-tab-trigger'));
				const panels = Array.from(group.querySelectorAll('.article-tab-panel'));
				if (!triggers.length || !panels.length) return;

				const activate = (targetId) => {
					triggers.forEach((trigger) => {
						const isActive = trigger.dataset.tabTarget === targetId;
						trigger.classList.toggle('is-active', isActive);
						trigger.setAttribute('aria-selected', isActive ? 'true' : 'false');
					});
					panels.forEach((panel) => {
						panel.classList.toggle('is-active', panel.id === targetId);
					});
				};

				triggers.forEach((trigger) => {
					trigger.addEventListener('click', () => {
						const targetId = trigger.dataset.tabTarget;
						if (targetId) activate(targetId);
					});
				});

				const initial = triggers.find((trigger) => trigger.classList.contains('is-active'))?.dataset.tabTarget;
				if (initial) activate(initial);
			};

			const init = () => {
				document.querySelectorAll('[data-tab-group]').forEach((group) => setupTabGroup(group));
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', init, { once: true });
			} else {
				init();
				}
			})();
		</script>
		<script is:inline>
			(() => {
				// Close the language dropdown on outside click
				const wraps = document.querySelectorAll('details.lang-wrap');
				document.addEventListener('click', (event) => {
					wraps.forEach((wrap) => {
						if (wrap.hasAttribute('open') && !wrap.contains(event.target)) {
							wrap.removeAttribute('open');
						}
					});
				});
			})();
		</script>
		</body>
</html>

<style is:global>
  /* ── Sticky nav (zine) ── */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px;
    height: 64px;
    gap: 24px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .logo:hover { color: var(--ink); }
  .logo-mark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--yellow);
    border: 2px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 800;
    font-size: 15px;
    color: var(--ink);
    transform: rotate(-4deg);
    transition: transform 0.2s;
  }
  .logo:hover .logo-mark { transform: rotate(4deg); }
  .logo-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--ink);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-links a {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    padding: 7px 14px;
    border-radius: 99px;
    transition: all 0.15s;
    white-space: nowrap;
    border: 2px solid transparent;
  }
  .nav-links a:hover { color: var(--ink); background: var(--paper-2); }
  .nav-links a.active {
    color: var(--ink);
    background: var(--yellow);
    border-color: var(--ink);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .nav-lib {
    font-family: var(--display);
    font-size: 14px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 99px;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    transition: all 0.15s;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .nav-lib:hover {
    background: var(--yellow);
    color: var(--ink);
    transform: translate(-1px,-1px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .nav-cta {
    font-family: var(--display);
    font-size: 14px;
    font-weight: 700;
    padding: 9px 20px;
    border-radius: 99px;
    background: var(--ink);
    color: var(--paper);
    border: 2px solid var(--ink);
    transition: all 0.15s;
    white-space: nowrap;
    display: inline-block;
  }
  .nav-cta:hover {
    background: var(--coral);
    color: var(--paper);
    transform: translate(-1px,-1px);
    box-shadow: 2px 2px 0 var(--ink);
  }

  /* Language dropdown */
  .lang-wrap { position: relative; }
  .lang-wrap[open] { z-index: 200; }
  .lang-wrap summary { list-style: none; }
  .lang-wrap summary::-webkit-details-marker { display: none; }
  .lang-btn {
    font-family: var(--display);
    font-size: 13px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 99px;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.15s;
    white-space: nowrap;
    cursor: pointer;
  }
  .lang-btn:hover {
    background: var(--paper-2);
    transform: translate(-1px,-1px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .lang-btn .caret {
    font-size: 10px;
    transition: transform 0.15s;
  }
  .lang-wrap[open] .lang-btn .caret { transform: rotate(180deg); }
  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--ink);
    padding: 6px;
    display: flex;
    flex-direction: column;
    min-width: 150px;
    z-index: 200;
  }
  .lang-opt {
    font-size: 14px;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 8px;
    text-align: left;
    color: var(--ink-2);
    transition: all 0.12s;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    white-space: nowrap;
  }
  .lang-opt:hover { background: var(--paper-2); color: var(--ink); }
  .lang-opt.selected { background: var(--yellow); color: var(--ink); }
  .lang-opt .check { font-weight: 700; visibility: hidden; }
  .lang-opt.selected .check { visibility: visible; }

  @media (max-width: 960px) {
    .nav-links { display: none; }
  }
  @media (max-width: 640px) {
    .site-nav { padding: 0 16px; gap: 12px; }
    .logo-name { display: none; }
    .nav-lib { display: none; }
  }
</style>
