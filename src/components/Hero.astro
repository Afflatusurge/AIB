---
interface Props {
  lang: string;
  t: (key: string) => string;
  leadBrief?: { title: string; slug?: string; category?: string; commentary?: string };
  leadTool?: { title: string; slug?: string; pricing?: string; bestFor?: string };
  leadCase?: { title: string; slug?: string; industry?: string; problemType?: string };
}
const { lang } = Astro.props;
const editorialTimeZone = 'America/Los_Angeles';
const editorialLocale = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';
const editionDate = new Intl.DateTimeFormat(editorialLocale, {
  timeZone: editorialTimeZone,
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date());

const badgeLabel =
  lang === 'zh'
    ? `今日简报已更新 — ${editionDate}`
    : lang === 'ja'
      ? `本日のブリーフ公開中 — ${editionDate}`
      : `Today's edition is live — ${editionDate}`;

const stickers =
  lang === 'zh'
    ? ['50+ 工具评测', '每日更新', '零炒作']
    : lang === 'ja'
      ? ['50+ ツールレビュー', '毎日更新', '誇張ゼロ']
      : ['50+ tool reviews', 'Daily, not weekly', 'Zero hype'];

const ctaPrimary = lang === 'zh' ? '阅读今日简报 →' : lang === 'ja' ? '今日のブリーフを読む →' : "Read today's brief →";
const ctaSecondary = lang === 'zh' ? '浏览实战指南' : lang === 'ja' ? 'プレイブックを見る' : 'Browse playbooks';
---

<section class="hero">
  <span class="sticker sticker-1">{stickers[0]}</span>
  <span class="sticker sticker-2">{stickers[1]}</span>
  <span class="sticker sticker-3">{stickers[2]}</span>

  <div class="hero-badge"><span class="dot"></span> {badgeLabel}</div>

  <h1>
    {lang === 'zh' ? (
      <>用 AI 驱动你的<span class="hl">一人公司</span>——不再被<span class="hl hl-coral">噪音</span>淹没。</>
    ) : lang === 'ja' ? (
      <>AIで動かす、<span class="hl">ひとりビジネス</span>。<span class="hl hl-coral">ノイズ</span>に溺れずに。</>
    ) : (
      <>Build your one-person business, <span class="hl">powered by AI</span> — without drowning in <span class="hl hl-coral">the noise.</span></>
    )}
  </h1>

  <p class="hero-sub">
    {lang === 'zh' ? (
      <>一份<strong>每日简报</strong>，告诉你真正重要的事。<strong>工具评测</strong>帮你做决定。<strong>实战指南</strong>带你一步步执行——不需要团队。</>
    ) : lang === 'ja' ? (
      <>本当に重要なことだけを伝える<strong>デイリーブリーフ</strong>。意思決定を助ける<strong>ツールレビュー</strong>。チームなしで実行できる<strong>プレイブック</strong>。</>
    ) : (
      <>One <strong>daily brief</strong> that tells you what actually matters. <strong>Tool reviews</strong> that help you decide. <strong>Playbooks</strong> that walk you through execution — step by step, no team required.</>
    )}
  </p>

  <div class="hero-actions">
    <a href={`/${lang}/daily/`} class="btn-big">{ctaPrimary}</a>
    <a href={`/${lang}/playbooks/`} class="btn-outline">{ctaSecondary}</a>
  </div>
</section>

<style>
  .hero {
    padding: 72px 32px 64px;
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 99px;
    background: var(--paper-2);
    border: 2px solid var(--ink);
    margin-bottom: 28px;
    transform: rotate(-1deg);
  }
  .hero-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 2s infinite;
  }
  .hero h1 {
    font-family: var(--display);
    font-size: clamp(44px, 6.6vw, 92px);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.035em;
    max-width: 950px;
    margin-bottom: 28px;
  }
  :global(.lang-zh) .hero h1,
  :global(.lang-ja) .hero h1 {
    line-height: 1.12;
    letter-spacing: -0.01em;
    font-size: clamp(38px, 5.6vw, 76px);
  }
  .hl {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    padding: 0 6px;
    margin: 0 -2px;
    z-index: 0;
  }
  .hl::before {
    content: '';
    position: absolute;
    inset: 8% -2px 6%;
    background: var(--yellow);
    z-index: -1;
    border-radius: 6px;
    transform: rotate(-1deg);
  }
  .hl.hl-coral::before { background: var(--coral); }
  .hl.hl-coral { color: var(--paper); }
  .hero-sub {
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 560px;
    margin-bottom: 40px;
  }
  .hero-sub strong { color: var(--ink); font-weight: 600; }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* floating stickers */
  .sticker {
    position: absolute;
    font-family: var(--display);
    font-weight: 700;
    font-size: 14px;
    padding: 8px 16px;
    border-radius: 99px;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    user-select: none;
    animation: float 5s ease-in-out infinite;
  }
  .sticker-1 { top: 60px; right: 130px; background: var(--blue); color: #fff; transform: rotate(7deg); animation-delay: 0s; }
  .sticker-2 { top: 150px; right: 40px; background: var(--pink); color: var(--ink); transform: rotate(-5deg); animation-delay: 1.2s; }
  .sticker-3 { top: 250px; right: 180px; background: var(--green); color: #fff; transform: rotate(3deg); animation-delay: 2.4s; }
  @media (max-width: 1100px) { .sticker { display: none; } }
  @media (max-width: 768px) {
    .hero { padding: 48px 18px 48px; }
    .hero-sub { font-size: 17px; }
  }
</style>
