---
interface Props {
  lang: string;
}
const { lang } = Astro.props;

const labels = {
  content: lang === 'zh' ? '内容' : lang === 'ja' ? 'コンテンツ' : 'Content',
  site: lang === 'zh' ? '网站' : lang === 'ja' ? 'サイト' : 'Site',
  daily: lang === 'zh' ? '每日简报' : lang === 'ja' ? 'デイリーブリーフ' : 'Daily Brief',
  tools: lang === 'zh' ? '工具评测' : lang === 'ja' ? 'ツールレビュー' : 'Tool Reviews',
  playbooks: lang === 'zh' ? '实战指南' : lang === 'ja' ? 'プレイブック' : 'Playbooks',
  cases: lang === 'zh' ? '案例分析' : lang === 'ja' ? 'ケーススタディ' : 'Case Studies',
  library: lang === 'zh' ? '资料库' : lang === 'ja' ? 'ライブラリ' : 'Library',
  about: lang === 'zh' ? '关于' : lang === 'ja' ? 'About' : 'About',
  terms: lang === 'zh' ? '服务条款' : lang === 'ja' ? '利用規約' : 'Terms of Service',
  cookies: lang === 'zh' ? '隐私设置' : lang === 'ja' ? 'Cookie設定' : 'Cookie Settings',
  tagline:
    lang === 'zh'
      ? '为 AI 一人公司提供每日简报、工具评测与实战指南。'
      : lang === 'ja'
        ? 'AIファーストの個人ビルダーのためのブリーフ、レビュー、プレイブック。'
        : 'Daily briefs, tool reviews, and playbooks for AI-first independent builders.',
  copy:
    lang === 'zh'
      ? 'AI 一人公司的内容站'
      : lang === 'ja'
        ? 'ソロビルダーのためのAIメディア'
        : 'AI-first media for solo builders',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <span class="foot-logo">AIandBusiness</span>
        <p>{labels.tagline}</p>
      </div>
      <div class="foot-cols">
        <div>
          <div class="foot-col-title">{labels.content}</div>
          <div class="foot-links">
            <a href={`/${lang}/daily/`}>{labels.daily}</a>
            <a href={`/${lang}/tools/`}>{labels.tools}</a>
            <a href={`/${lang}/playbooks/`}>{labels.playbooks}</a>
            <a href={`/${lang}/cases/`}>{labels.cases}</a>
          </div>
        </div>
        <div>
          <div class="foot-col-title">{labels.site}</div>
          <div class="foot-links">
            <a href="https://docs.aiandbusiness.com/" target="_blank" rel="noopener noreferrer">{labels.library}</a>
            <a href={`/${lang}/about/`}>{labels.about}</a>
            <a href={`/${lang}/terms/`}>{labels.terms}</a>
            <button type="button" class="foot-link-button" data-open-consent>{labels.cookies}</button>
          </div>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span class="foot-copy">© {new Date().getFullYear()} AIandBusiness.com · {labels.copy}</span>
      <div class="foot-legal">
        <a href={`/${lang}/terms/`}>{labels.terms}</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-open-consent]').forEach((button) => {
      button.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('aib:open-consent-settings'));
      });
    });
  })();
</script>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding: 64px 0 36px;
    border-top: 2px solid var(--ink);
  }
  .foot-grid {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }
  .foot-logo {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--paper);
  }
  .foot-brand p {
    font-size: 14px;
    color: rgba(255, 251, 242, 0.5);
    max-width: 300px;
    margin-top: 12px;
    line-height: 1.6;
  }
  .foot-cols {
    display: flex;
    gap: 72px;
    flex-wrap: wrap;
  }
  .foot-col-title {
    font-family: var(--display);
    font-size: 13px;
    font-weight: 700;
    color: var(--yellow);
    margin-bottom: 16px;
  }
  .foot-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  .foot-links a,
  .foot-link-button {
    font-size: 14px;
    color: rgba(255, 251, 242, 0.65);
    transition: color 0.15s;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
  }
  .foot-links a:hover,
  .foot-link-button:hover {
    color: var(--yellow);
  }
  .foot-bottom {
    border-top: 1.5px solid rgba(255, 251, 242, 0.15);
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .foot-copy {
    font-size: 13px;
    color: rgba(255, 251, 242, 0.4);
  }
  .foot-legal {
    display: flex;
    gap: 24px;
  }
  .foot-legal a {
    font-size: 13px;
    color: rgba(255, 251, 242, 0.4);
  }
  .foot-legal a:hover { color: var(--yellow); }
</style>
