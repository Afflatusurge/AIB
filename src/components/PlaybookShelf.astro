---
interface PlaybookCard {
  slug: string;
  title: string;
  category?: string;
  snippet: string;
  outcome: string;
  bestFor: string;
  useWhen: string;
}

interface Props {
  lang: string;
  playbooks: PlaybookCard[];
}

const { lang, playbooks } = Astro.props;
const primary = playbooks[0];
const secondary = playbooks.slice(1, 4);

const localizeCategory = (category?: string) => {
  if (!category) {
    return lang === 'zh' ? '实战手册' : lang === 'ja' ? 'プレイブック' : 'Playbook';
  }

  const labels: Record<string, { en: string; ja: string; zh: string }> = {
    Build: { en: 'Build', ja: '構築', zh: '搭建' },
    Media: { en: 'Media', ja: 'メディア', zh: '媒体' },
    Growth: { en: 'Growth', ja: '成長', zh: '增长' },
    Operations: { en: 'Operations', ja: '運営', zh: '运营' },
  };

  return labels[category]?.[lang as 'en' | 'ja' | 'zh'] ?? category;
};

const chipClass = (category?: string) => {
  switch (category) {
    case 'Growth': return 'c-growth';
    case 'Operations': return 'c-ops';
    case 'Media': return 'c-media';
    default: return 'c-default';
  }
};

const ui = {
  tag: lang === 'zh' ? '实战指南' : lang === 'ja' ? 'プレイブック' : 'Playbooks',
  title: lang === 'zh' ? '从想法到落地' : lang === 'ja' ? 'アイデアから実行へ' : 'From idea to execution',
  sub:
    lang === 'zh'
      ? '真正可执行的分步工作流——写给一个人的团队。'
      : lang === 'ja'
        ? '実際に使えるステップ形式のワークフロー。チーム1人のために。'
        : 'Step-by-step workflows you can actually use — written for a team of one.',
  all: lang === 'zh' ? '全部指南 →' : lang === 'ja' ? 'すべて見る →' : 'All playbooks →',
  outcome: lang === 'zh' ? '能得到什么' : lang === 'ja' ? '得られる結果' : 'Outcome',
  bestFor: lang === 'zh' ? '适合谁' : lang === 'ja' ? '向いている人' : 'Best for',
  whyNow: lang === 'zh' ? '为什么现在' : lang === 'ja' ? '今読む理由' : 'Why now',
  open: lang === 'zh' ? '打开这份指南' : lang === 'ja' ? 'このプレイブックを開く' : 'Open the playbook',
  read: lang === 'zh' ? '查看 →' : lang === 'ja' ? '読む →' : 'Read →',
};
---

{(primary || secondary.length > 0) && (
  <section class="section pbk-section">
    <div class="container">
      <div class="sec-head">
        <div>
          <span class="sec-tag tag-purple">{ui.tag}</span>
          <h2 class="sec-title">{ui.title}</h2>
          <p class="sec-sub">{ui.sub}</p>
        </div>
        <a href={`/${lang}/playbooks/`} class="sec-link">{ui.all}</a>
      </div>

      <div class="pbk-grid">
        {primary && (
          <a class="pbk-main" href={`/${lang}/playbooks/${primary.slug}/`}>
            <span class="pbk-cat">{localizeCategory(primary.category)}</span>
            <h3>{primary.title}</h3>
            <p>{primary.snippet}</p>
            <div class="pbk-facts">
              {primary.outcome && (
                <div class="pbk-fact">
                  <div class="pbk-fact-label">{ui.outcome}</div>
                  <p>{primary.outcome}</p>
                </div>
              )}
              {primary.bestFor && (
                <div class="pbk-fact">
                  <div class="pbk-fact-label">{ui.bestFor}</div>
                  <p>{primary.bestFor}</p>
                </div>
              )}
              {primary.useWhen && (
                <div class="pbk-fact">
                  <div class="pbk-fact-label">{ui.whyNow}</div>
                  <p>{primary.useWhen}</p>
                </div>
              )}
            </div>
            <div class="pbk-open">{ui.open} <span>→</span></div>
          </a>
        )}

        <div class="pbk-side">
          {secondary.map((playbook) => (
            <a class="pbk-card" href={`/${lang}/playbooks/${playbook.slug}/`}>
              <div class="pbk-card-top">
                <span class={`pbk-chip ${chipClass(playbook.category)}`}>{localizeCategory(playbook.category)}</span>
                <span class="pbk-read">{ui.read}</span>
              </div>
              <h4>{playbook.title}</h4>
              <p>{playbook.snippet}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .section { padding: 88px 0; }
  .pbk-section { padding-top: 0; }
  .tag-purple { background: var(--purple); color: #fff; }

  .pbk-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 24px;
    align-items: stretch;
  }
  .pbk-main {
    border: 2px solid var(--ink);
    border-radius: var(--r);
    background: var(--purple);
    color: #fff;
    box-shadow: var(--shadow);
    padding: 36px 38px;
    transition: all 0.18s;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .pbk-main::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.16) 1.5px, transparent 1.5px);
    background-size: 24px 24px;
  }
  .pbk-main > :global(*) { position: relative; }
  .pbk-main:hover {
    transform: translate(-3px,-3px);
    box-shadow: var(--shadow-lg);
    color: #fff;
  }
  .pbk-cat {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--display);
    font-size: 12.5px;
    font-weight: 700;
    background: var(--yellow);
    color: var(--ink);
    border: 2px solid var(--ink);
    padding: 5px 14px;
    border-radius: 99px;
    transform: rotate(-2deg);
    margin-bottom: 18px;
  }
  .pbk-main h3 {
    font-family: var(--display);
    font-size: clamp(28px, 2.8vw, 40px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin-bottom: 14px;
  }
  .pbk-main > p {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255,255,255,0.85);
    max-width: 480px;
  }
  .pbk-facts { margin-top: 26px; display: grid; gap: 14px; }
  .pbk-fact {
    background: rgba(255,255,255,0.12);
    border: 1.5px solid rgba(255,255,255,0.3);
    border-radius: 12px;
    padding: 14px 18px;
  }
  .pbk-fact-label {
    font-family: var(--display);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 4px;
  }
  .pbk-fact p {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255,255,255,0.9);
  }
  .pbk-open {
    margin-top: 26px;
    font-family: var(--display);
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.15s;
  }
  .pbk-main:hover .pbk-open { gap: 14px; }

  .pbk-side { display: flex; flex-direction: column; gap: 20px; }
  .pbk-card {
    border: 2px solid var(--ink);
    border-radius: var(--r);
    background: #fff;
    box-shadow: var(--shadow);
    padding: 24px 28px;
    transition: all 0.18s;
    flex: 1;
    display: block;
    color: var(--ink);
  }
  .pbk-card:hover {
    transform: translate(-3px,-3px);
    box-shadow: var(--shadow-lg);
    color: var(--ink);
  }
  .pbk-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .pbk-chip {
    font-family: var(--display);
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 99px;
    border: 1.5px solid var(--ink);
  }
  .pbk-chip.c-growth { background: var(--pink); }
  .pbk-chip.c-ops { background: var(--yellow); }
  .pbk-chip.c-media { background: var(--sky); }
  .pbk-chip.c-default { background: var(--paper-2); }
  .pbk-read {
    font-family: var(--display);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-3);
    transition: color 0.15s;
  }
  .pbk-card:hover .pbk-read { color: var(--coral); }
  .pbk-card h4 {
    font-family: var(--display);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin-bottom: 8px;
  }
  .pbk-card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .pbk-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .pbk-main { padding: 28px 24px; }
  }
</style>
