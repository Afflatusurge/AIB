---
interface Brief {
  id: string;
  slug?: string;
  title: string;
  snippet: string;
  category: string;
  impact: string;
  date: string;
  sourcePublishedDate?: string;
  whyItMatters?: string;
}

interface Props {
  lang: string;
  t: (key: string) => string;
  briefs: Brief[];
}

const { lang, briefs } = Astro.props;
const editorialTimeZone = 'America/Los_Angeles';
const editorialLocale = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';
const latestEditionDate = briefs[0]?.sourcePublishedDate || briefs[0]?.date || '';
const parsedEditionDate = latestEditionDate ? new Date(`${latestEditionDate}T12:00:00Z`) : new Date();
const editionDay = new Intl.DateTimeFormat(editorialLocale, {
  timeZone: editorialTimeZone,
  month: 'short',
  day: 'numeric',
}).format(parsedEditionDate);
const todayParts = new Intl.DateTimeFormat('en-US', {
  timeZone: editorialTimeZone,
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).formatToParts(new Date());
const todayPart = (type: string) => todayParts.find((part) => part.type === type)?.value || '';
const todayKey = `${todayPart('year')}-${todayPart('month')}-${todayPart('day')}`;
const editionPrefix = latestEditionDate === todayKey
  ? (lang === 'zh' ? '今日' : lang === 'ja' ? '本日' : 'Today')
  : (lang === 'zh' ? '最近一期' : lang === 'ja' ? '最新号' : 'Latest');

const categoryClass: Record<string, string> = {
  'LLM': 'llm',
  'Agent': 'agent',
  'Business': 'business',
  'Coding': 'coding',
  'Hardware': 'hardware',
  'Image': 'image',
  'Video': 'video',
};

const ui = {
  tag: `${editionPrefix} · ${editionDay}`,
  title: lang === 'zh' ? '只看信号，不看噪音。' : lang === 'ja' ? 'シグナルだけ。ノイズは無し。' : 'Signal, not noise.',
  sub:
    lang === 'zh'
      ? '过去 24 小时的 AI 动态——按对独立创业者的实用性排序，而不是按热度。'
      : lang === 'ja'
        ? '過去24時間のAIの動き。話題性ではなく、個人ビルダーへの有用性でランク付け。'
        : 'What mattered in AI over the last 24 hours — ranked by usefulness to independent builders, not by hype.',
  full: lang === 'zh' ? '完整简报 →' : lang === 'ja' ? 'ブリーフ全文 →' : 'Full brief →',
  why: lang === 'zh' ? '为什么重要：' : lang === 'ja' ? 'なぜ重要か：' : 'Why it matters:',
  empty: lang === 'zh' ? '今日暂无新信号' : lang === 'ja' ? '本日の新しいシグナルはありません' : 'No new signals today',
};
---

<section class="brief-band section">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="sec-tag band-tag" data-live-edition-tag>{ui.tag}</span>
        <h2 class="sec-title band-title">{ui.title}</h2>
        <p class="sec-sub band-sub">{ui.sub}</p>
      </div>
      <a href={`/${lang}/daily/`} class="sec-link band-link">{ui.full}</a>
    </div>

    <div class="brief-grid" data-live-signal-items>
      {briefs.length > 0 ? briefs.slice(0, 4).map((brief, i) => (
        <a href={`/${lang}/daily/${brief.slug || brief.id}/`} class="signal-item brief-card">
          <span class="signal-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="signal-row brief-top">
            <span class={`signal-category ${categoryClass[brief.category] || 'llm'}`}>{brief.category || 'AI'}</span>
            <span class={`signal-impact ${(brief.impact || 'notable').toLowerCase()}`}>{brief.impact || 'Notable'}</span>
          </div>
          <h4>{brief.title}</h4>
          <p>{brief.snippet}</p>
          <div class="brief-why" style={brief.whyItMatters ? '' : 'display:none'}>
            <b>{ui.why}</b> <span class="brief-why-text">{brief.whyItMatters || ''}</span>
          </div>
        </a>
      )) : (
        <div class="signal-empty">
          <p>{ui.empty}</p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .section { padding: 88px 0; }
  .brief-band {
    background: var(--ink);
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    color: var(--paper);
  }
  .band-tag {
    background: transparent;
    border-color: var(--paper);
    color: var(--yellow);
    transform: rotate(1.5deg);
  }
  .band-title { color: var(--paper); }
  .band-sub { color: rgba(255,251,242,0.6); }
  .band-link {
    background: var(--yellow);
    color: var(--ink);
    border-color: var(--yellow);
    box-shadow: 3px 3px 0 rgba(255,212,61,0.35);
  }
  .band-link:hover {
    box-shadow: 5px 5px 0 rgba(255,212,61,0.35);
    background: var(--yellow);
    color: var(--ink);
  }

  .brief-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .brief-card {
    border: 2px solid rgba(255,251,242,0.18);
    border-radius: var(--r);
    padding: 26px 28px;
    background: rgba(255,251,242,0.04);
    transition: all 0.18s;
    display: block;
    color: var(--paper);
  }
  .brief-card:hover {
    border-color: var(--yellow);
    background: rgba(255,212,61,0.06);
    transform: translateY(-3px);
    color: var(--paper);
  }
  .signal-index { display: none; }
  .brief-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .signal-category,
  .signal-impact {
    font-family: var(--display);
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 99px;
    border: 1.5px solid currentColor;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .signal-category.coding { color: #FF8669; }
  .signal-category.image { color: #7FB5FF; }
  .signal-category.agent { color: #5ED696; }
  .signal-category.video { color: #FFD43D; }
  .signal-category.llm { color: #C9A9FF; }
  .signal-category.business { color: #FFB0D3; }
  .signal-category.hardware { color: #9AE0E8; }
  .signal-impact.major {
    background: var(--coral);
    border-color: var(--coral);
    color: #fff;
  }
  .signal-impact.notable { color: rgba(255,251,242,0.5); }
  .signal-impact.routine { color: rgba(255,251,242,0.35); }
  .brief-card h4 {
    font-family: var(--display);
    font-size: 21px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin-bottom: 10px;
    color: var(--paper);
  }
  .brief-card:hover h4 { color: var(--yellow); }
  .brief-card > p {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255,251,242,0.55);
  }
  .brief-why {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(255,212,61,0.08);
    border-left: 3px solid var(--yellow);
    font-size: 13px;
    line-height: 1.55;
    color: rgba(255,251,242,0.75);
  }
  .brief-why b { color: var(--yellow); font-weight: 600; }
  .signal-empty {
    grid-column: 1 / -1;
    padding: 48px 24px;
    text-align: center;
    color: rgba(255,251,242,0.5);
    font-size: 14px;
    border: 2px dashed rgba(255,251,242,0.2);
    border-radius: var(--r);
  }

  @media (max-width: 960px) {
    .brief-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .section { padding: 64px 0; }
    .brief-card { padding: 22px 22px; }
  }
</style>
