---
interface Tool {
  title: string;
  snippet: string;
  rating: number;
  pricing: string;
  slug: string;
  date: string;
  category?: string;
  bestFor?: string;
  coverImage?: string;
}
interface Case {
  title: string;
  snippet: string;
  industry: string;
  revenue: string;
  slug: string;
  date: string;
  problemType?: string;
  coverImage?: string;
}
interface Props {
  lang: string;
  t: (key: string) => string;
  briefs: Array<{ title: string; slug: string; category?: string }>;
  tools: Tool[];
  cases: Case[];
}

const { lang, briefs, tools, cases } = Astro.props;

const leadTool = tools[0];
const leadCase = cases[0];

const audiencePills = (leadTool?.bestFor || '')
  .split(/[,，、]/)
  .map((item) => item.trim())
  .filter(Boolean)
  .slice(0, 3);

const caseStats = [leadCase?.revenue, leadCase?.industry, leadCase?.problemType].filter(Boolean).slice(0, 3);

const recentReads = [
  ...briefs.slice(0, 2).map((item) => ({ href: `/${lang}/daily/${item.slug}/`, title: item.title, meta: item.category || 'Daily Brief' })),
  ...tools.slice(1, 3).map((item) => ({ href: `/${lang}/tools/${item.slug}/`, title: item.title, meta: item.bestFor || item.category || 'Tool Review' })),
  ...cases.slice(1, 3).map((item) => ({ href: `/${lang}/cases/${item.slug}/`, title: item.title, meta: item.problemType || item.industry || 'Case Study' })),
].slice(0, 3);

const ui = {
  tag: lang === 'zh' ? '值得你花时间' : lang === 'ja' ? '読む価値あり' : 'Worth your time',
  title: lang === 'zh' ? '本周深度内容' : lang === 'ja' ? '今週のディープダイブ' : "This week's deep dives",
  library: lang === 'zh' ? '看全部评测 →' : lang === 'ja' ? 'レビュー一覧へ →' : 'All reviews →',
  leadKicker: lang === 'zh' ? '主打 · 工具评测' : lang === 'ja' ? 'リード · ツールレビュー' : 'Lead story · Tool review',
  leadFallbackTitle:
    lang === 'zh'
      ? '优先打造一篇足够代表站点气质的标杆评测'
      : lang === 'ja'
        ? 'サイトを代表する基幹レビューをまず一本'
        : 'Start with one flagship review that sets the tone for the whole site',
  leadFallbackCopy:
    lang === 'zh'
      ? '首页需要一篇足够"厚"的主文章，承担品牌解释、方法论和差异化感知。'
      : lang === 'ja'
        ? '厚みのある主役記事は、ブランドの違いと方法論を最短で伝えます。'
        : 'A substantial lead review helps explain the site’s judgment, standards, and point of view at a glance.',
  caseKicker: lang === 'zh' ? '案例分析 · 最新' : lang === 'ja' ? 'ケーススタディ · 新着' : 'Case study · New',
  caseFallbackTitle:
    lang === 'zh'
      ? '案例页应该回答"别人是怎么做成的"'
      : lang === 'ja'
        ? 'ケースは「他の人はどうやったか」に答える'
        : 'Case studies should answer how others actually made it work',
  reads: lang === 'zh' ? '继续阅读' : lang === 'ja' ? '最近の記事' : 'Recent reads',
  fresh: lang === 'zh' ? '新' : lang === 'ja' ? '新着' : 'Fresh',
  readsEmpty:
    lang === 'zh'
      ? '内容同步后这里会显示最近更新。'
      : lang === 'ja'
        ? '同期後に最新記事が表示されます。'
        : 'Recent stories will appear here after content sync.',
};
---

<section class="section">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="sec-tag tag-yellow">{ui.tag}</span>
        <h2 class="sec-title">{ui.title}</h2>
      </div>
      <a href={`/${lang}/tools/`} class="sec-link">{ui.library}</a>
    </div>

    <div class="feat-grid">
      <a class="feat-main" href={leadTool ? `/${lang}/tools/${leadTool.slug}/` : `/${lang}/tools/`}>
        <div class="feat-visual">
          {leadTool?.coverImage ? (
            <img src={leadTool.coverImage} alt={leadTool.title} loading="lazy" />
          ) : (
            <span class="feat-glyph" aria-hidden="true">A!</span>
          )}
          {leadTool?.category && <span class="chip-float">{leadTool.category}</span>}
        </div>
        <div class="feat-body">
          <div class="feat-kicker">{ui.leadKicker}</div>
          <div class="feat-title">{leadTool?.title || ui.leadFallbackTitle}</div>
          <p>{leadTool?.snippet || ui.leadFallbackCopy}</p>
          {audiencePills.length > 0 && (
            <div class="feat-meta">
              {audiencePills.map((pill) => (
                <span class="meta-pill">{pill}</span>
              ))}
            </div>
          )}
        </div>
      </a>

      <div class="feat-side">
        <a class="case-card" href={leadCase ? `/${lang}/cases/${leadCase.slug}/` : `/${lang}/cases/`}>
          <div class="case-kicker">{ui.caseKicker}</div>
          <h3>{leadCase?.title || ui.caseFallbackTitle}</h3>
          <p>{leadCase?.snippet || ''}</p>
          {caseStats.length > 0 && (
            <div class="case-stats">
              {caseStats.map((stat) => (
                <span class="case-stat">{stat}</span>
              ))}
            </div>
          )}
        </a>

        <div class="reads-card">
          <div class="reads-title">{ui.reads} <span class="tag-mini">{ui.fresh}</span></div>
          {recentReads.length > 0 ? recentReads.map((item, i) => (
            <a class="read-item" href={item.href}>
              <span class="read-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="read-copy">
                <span class="read-title">{item.title}</span>
                <span class="read-meta">{item.meta}</span>
              </span>
            </a>
          )) : (
            <p class="reads-empty">{ui.readsEmpty}</p>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section { padding: 88px 0; }
  .tag-yellow { background: var(--yellow); }

  .feat-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 24px;
    align-items: stretch;
  }
  .feat-main {
    border: 2px solid var(--ink);
    border-radius: var(--r);
    background: #fff;
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: all 0.18s;
    display: flex;
    flex-direction: column;
    color: var(--ink);
  }
  .feat-main:hover {
    transform: translate(-3px,-3px);
    box-shadow: var(--shadow-lg);
    color: var(--ink);
  }
  .feat-visual {
    border-bottom: 2px solid var(--ink);
    position: relative;
    overflow: hidden;
    background: var(--blue);
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .feat-visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.22) 1.5px, transparent 1.5px);
    background-size: 20px 20px;
  }
  .feat-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
  }
  .feat-glyph {
    font-family: var(--display);
    font-weight: 800;
    font-size: 64px;
    color: #fff;
    opacity: 0.4;
    transform: rotate(-3deg);
    position: relative;
  }
  .chip-float {
    position: absolute;
    top: 28px;
    right: 28px;
    font-family: var(--display);
    font-size: 13px;
    font-weight: 700;
    background: var(--yellow);
    color: var(--ink);
    border: 2px solid var(--ink);
    padding: 6px 14px;
    border-radius: 99px;
    transform: rotate(4deg);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .feat-body { padding: 28px 32px 30px; flex: 1; }
  .feat-kicker {
    font-family: var(--display);
    font-size: 12px;
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .feat-title {
    font-family: var(--display);
    font-weight: 800;
    font-size: 28px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 6px 0 10px;
  }
  .feat-body p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .feat-meta { display: flex; gap: 8px; margin-top: 18px; flex-wrap: wrap; }

  .feat-side { display: flex; flex-direction: column; gap: 20px; }
  .case-card {
    border: 2px solid var(--ink);
    border-radius: var(--r);
    background: var(--green);
    color: #fff;
    box-shadow: var(--shadow);
    padding: 28px 30px;
    transition: all 0.18s;
    position: relative;
    overflow: hidden;
    display: block;
  }
  .case-card:hover {
    transform: translate(-3px,-3px);
    box-shadow: var(--shadow-lg);
    color: #fff;
  }
  .case-kicker {
    font-family: var(--display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    margin-bottom: 10px;
  }
  .case-card h3 {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin-bottom: 12px;
  }
  .case-card p {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255,255,255,0.8);
  }
  .case-stats { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
  .case-stat {
    background: rgba(255,255,255,0.14);
    border: 1.5px solid rgba(255,255,255,0.35);
    border-radius: 10px;
    padding: 8px 14px;
    font-family: var(--display);
    font-size: 13px;
    font-weight: 700;
  }

  .reads-card {
    border: 2px solid var(--ink);
    border-radius: var(--r);
    background: #fff;
    box-shadow: var(--shadow);
    padding: 24px 30px;
    flex: 1;
  }
  .reads-title {
    font-family: var(--display);
    font-size: 15px;
    font-weight: 800;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .reads-title .tag-mini {
    font-size: 11px;
    padding: 2px 10px;
    border-radius: 99px;
    background: var(--pink);
    border: 1.5px solid var(--ink);
    transform: rotate(-2deg);
  }
  .read-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1.5px dashed rgba(27,26,23,0.2);
    color: var(--ink);
  }
  .read-item:last-child { border-bottom: none; padding-bottom: 0; }
  .read-item:hover .read-title { color: var(--coral); }
  .read-num {
    font-family: var(--display);
    font-weight: 800;
    font-size: 13px;
    color: var(--ink-3);
    flex-shrink: 0;
  }
  .read-copy { display: block; min-width: 0; }
  .read-title {
    display: block;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    transition: color 0.15s;
  }
  .read-meta {
    display: block;
    font-size: 12px;
    color: var(--ink-3);
    margin-top: 1px;
  }
  .reads-empty {
    font-size: 13.5px;
    color: var(--ink-3);
    line-height: 1.6;
    padding-top: 8px;
  }

  @media (max-width: 960px) {
    .feat-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .section { padding: 64px 0; }
    .feat-body { padding: 24px 24px 26px; }
  }
</style>
