---
import type { ToolReview } from '../../lib/notion';
import PaginationNav from '../PaginationNav.astro';

interface Props {
  lang: 'en' | 'zh' | 'ja';
  t: (key: any) => string;
  leadTool?: ToolReview;
  tools: ToolReview[];
  currentPage: number;
  totalPages: number;
}

const { lang, t, leadTool, tools, currentPage, totalPages } = Astro.props;
const paginationLabels = {
  previous: lang === 'zh' ? '上一页' : lang === 'ja' ? '前へ' : 'Previous',
  next: lang === 'zh' ? '下一页' : lang === 'ja' ? '次へ' : 'Next',
  page: lang === 'zh' ? '页码' : lang === 'ja' ? 'ページ' : 'Page',
  loadMore: lang === 'zh' ? '加载更多' : lang === 'ja' ? 'もっと見る' : 'Load more',
};

const visualColors = ['v-purple', 'v-coral', 'v-green', 'v-blue', 'v-yellow', 'v-pink'];
const glyph = (tool: ToolReview) => (tool.category || tool.title || 'AI').replace(/\s/g, '').slice(0, 2);

const categories = [...new Set(tools.map((tool) => tool.category).filter(Boolean))] as string[];

const ui = {
  home: t('nav.home'),
  count: lang === 'zh' ? '评测与指南' : lang === 'ja' ? 'レビュー＆ガイド' : 'reviews & guides',
  lede:
    lang === 'zh'
      ? '不用开 40 个标签页，也能选对工具。每篇评测都从一人公司的视角实测。'
      : lang === 'ja'
        ? 'タブを40個開かずに、使うものを決める。すべてのレビューは、ひとりビジネスの視点で検証済み。'
        : 'Decide what to use — without 40 open tabs. Every review is tested through the lens of a one-person business.',
  all: lang === 'zh' ? '全部' : lang === 'ja' ? 'すべて' : 'All',
  latest: lang === 'zh' ? '最新' : lang === 'ja' ? '最新' : 'Latest',
  readGuide: lang === 'zh' ? '阅读评测' : lang === 'ja' ? 'レビューを読む' : 'Read the guide',
  bestFor: lang === 'zh' ? '适合：' : lang === 'ja' ? '向いている人：' : 'Best for:',
};
---

<header class="page-head c-blue">
  <div class="container">
    <div class="crumb"><a href={`/${lang}/`}>{ui.home}</a> / {t('nav.tools')}</div>
    <div class="page-title-row">
      <h1>{t('nav.tools')}</h1>
      <span class="count-pill">{tools.length + (leadTool ? 1 : 0)}+ {ui.count}</span>
    </div>
    <p class="lede">{ui.lede}</p>
  </div>
</header>

{categories.length > 1 && (
  <div class="filter-bar">
    <div class="container">
      <div class="filter-chips" data-filter-chips>
        <button class="f-chip on" data-filter="*">{ui.all}</button>
        {categories.map((category) => (
          <button class="f-chip" data-filter={category}>{category}</button>
        ))}
      </div>
    </div>
  </div>
)}

<main class="section">
  <div class="container">
    {leadTool && (
      <a class="lead-review fade-in" href={`/${lang}/tools/${leadTool.slug || leadTool.id}/`}>
        <div class={`lead-img ${leadTool.coverImage ? '' : 'v-blue'}`}>
          {leadTool.coverImage && <img src={leadTool.coverImage} alt={leadTool.title} loading="lazy" />}
          {leadTool.category && <span class="chip-float">{leadTool.category}</span>}
        </div>
        <div class="lead-body">
          <div class="lead-kicker kicker-blue">{ui.latest}{leadTool.category ? ` · ${leadTool.category}` : ''}</div>
          <h2>{leadTool.title}</h2>
          <p>{leadTool.snippet}</p>
          <div class="lead-meta">
            {(leadTool.bestFor || '')
              .split(/[,，、]/)
              .map((item) => item.trim())
              .filter(Boolean)
              .slice(0, 3)
              .map((pill) => (
                <span class="meta-pill">{pill}</span>
              ))}
          </div>
          <div class="lead-cta">{ui.readGuide} <span>→</span></div>
        </div>
      </a>
    )}

    <div class="card-grid" data-paginated-list>
      {tools.map((tool, i) => (
        <a
          class="content-card fade-in"
          style={`animation-delay: ${i * 60}ms`}
          href={`/${lang}/tools/${tool.slug || tool.id}/`}
          data-category={tool.category || ''}
        >
          <div class={`rv-visual ${visualColors[i % visualColors.length]}`}>
            <span class="rv-glyph">{glyph(tool)}</span>
            {tool.coverImage && <img src={tool.coverImage} alt={tool.title} loading="lazy" />}
          </div>
          <div class="card-meta">
            <span class="card-badge">{tool.category || 'AI'}</span>
            <span class="card-date">{tool.date}</span>
          </div>
          <h2>{tool.title}</h2>
          <p class="card-snippet">{tool.snippet}</p>
          {(tool.bestFor || tool.pricing) && (
            <div class="rv-for"><b>{ui.bestFor}</b> {tool.bestFor || tool.pricing}</div>
          )}
        </a>
      ))}
      {!leadTool && tools.length === 0 && (
        <div class="empty-state">No tool reviews yet.</div>
      )}
    </div>

    <PaginationNav
      basePath={`/${lang}/tools/`}
      currentPage={currentPage}
      totalPages={totalPages}
      labels={paginationLabels}
    />
  </div>
</main>

<script is:inline>
  (() => {
    const chips = document.querySelectorAll('[data-filter-chips] .f-chip');
    if (!chips.length) return;
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((other) => other.classList.remove('on'));
        chip.classList.add('on');
        const filter = chip.dataset.filter;
        document.querySelectorAll('[data-paginated-list] [data-category]').forEach((card) => {
          card.style.display = filter === '*' || card.dataset.category === filter ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  .section { padding: 56px 0 88px; }
  .kicker-blue { color: var(--blue); }
  .content-card .card-date {
    margin-bottom: 0;
    font-size: 12px;
    color: var(--ink-3);
  }
  .content-card .card-meta { margin-bottom: 12px; }
  .content-card h2 { margin-top: 0; }
  .rv-for {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1.5px dashed rgba(27,26,23,0.2);
    font-size: 12px;
    color: var(--ink-3);
  }
  .rv-for b { color: var(--ink-2); font-weight: 600; }
</style>
