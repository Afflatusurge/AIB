---
import type { CaseStudy } from '../../lib/notion';
import PaginationNav from '../PaginationNav.astro';

interface Props {
  lang: 'en' | 'zh' | 'ja';
  t: (key: any) => string;
  leadCase?: CaseStudy;
  cases: CaseStudy[];
  currentPage: number;
  totalPages: number;
}

const { lang, t, leadCase, cases, currentPage, totalPages } = Astro.props;
const paginationLabels = {
  previous: lang === 'zh' ? '上一页' : lang === 'ja' ? '前へ' : 'Previous',
  next: lang === 'zh' ? '下一页' : lang === 'ja' ? '次へ' : 'Next',
  page: lang === 'zh' ? '页码' : lang === 'ja' ? 'ページ' : 'Page',
  loadMore: lang === 'zh' ? '加载更多' : lang === 'ja' ? 'もっと見る' : 'Load more',
};

const visualColors = ['v-green', 'v-pink', 'v-blue', 'v-purple', 'v-coral', 'v-yellow'];
const glyph = (cs: CaseStudy) => (cs.problemType || cs.industry || cs.title || 'CS').replace(/\s/g, '').slice(0, 2);

const categories = [...new Set(cases.map((cs) => cs.problemType || cs.industry).filter(Boolean))] as string[];

const ui = {
  home: t('nav.home'),
  count: lang === 'zh' ? '真实案例' : lang === 'ja' ? '実例' : 'real builders',
  lede:
    lang === 'zh'
      ? '别人是怎么做成的？按问题和结果组织的案例库——收入、流程、可复制的做法。'
      : lang === 'ja'
        ? '他の人はどうやって成功したのか。課題と成果で整理されたケースライブラリ。'
        : 'How others actually made it work. A case library organized around problems and outcomes — revenue, workflow shifts, repeatable moves.',
  all: lang === 'zh' ? '全部' : lang === 'ja' ? 'すべて' : 'All',
  breakdown: lang === 'zh' ? '案例拆解' : lang === 'ja' ? 'ケース分解' : 'Case breakdown',
  readCase: lang === 'zh' ? '阅读案例' : lang === 'ja' ? 'ケースを読む' : 'Read the case',
};
---

<header class="page-head c-purple">
  <div class="container">
    <div class="crumb"><a href={`/${lang}/`}>{ui.home}</a> / {t('nav.cases')}</div>
    <div class="page-title-row">
      <h1>{t('nav.cases')}</h1>
      <span class="count-pill">✦ {ui.count}</span>
    </div>
    <p class="lede">{ui.lede}</p>
  </div>
</header>

{categories.length > 1 && (
  <div class="filter-bar">
    <div class="container">
      <div class="filter-chips" data-filter-chips>
        <button class="f-chip on" data-filter="*">{ui.all}</button>
        {categories.map((category) => (
          <button class="f-chip" data-filter={category}>{category}</button>
        ))}
      </div>
    </div>
  </div>
)}

<main class="section">
  <div class="container">
    {leadCase && (
      <a class="lead-review fade-in" href={`/${lang}/cases/${leadCase.slug || leadCase.id}/`}>
        <div class={`lead-img ${leadCase.coverImage ? '' : 'v-green'}`}>
          {leadCase.coverImage && <img src={leadCase.coverImage} alt={leadCase.title} loading="lazy" />}
          {(leadCase.problemType || leadCase.industry) && (
            <span class="chip-float">{leadCase.problemType || leadCase.industry}</span>
          )}
        </div>
        <div class="lead-body">
          <div class="lead-kicker kicker-purple">{ui.breakdown}</div>
          <h2>{leadCase.title}</h2>
          <p>{leadCase.snippet}</p>
          <div class="lead-meta">
            {[leadCase.revenue, leadCase.industry, leadCase.problemType].filter(Boolean).slice(0, 3).map((stat) => (
              <span class="meta-pill">{stat}</span>
            ))}
          </div>
          <div class="lead-cta">{ui.readCase} <span>→</span></div>
        </div>
      </a>
    )}

    <div class="card-grid" data-paginated-list>
      {cases.map((cs, i) => (
        <a
          class="content-card fade-in"
          style={`animation-delay: ${i * 60}ms`}
          href={`/${lang}/cases/${cs.slug || cs.id}/`}
          data-category={cs.problemType || cs.industry || ''}
        >
          <div class={`rv-visual ${visualColors[i % visualColors.length]}`}>
            <span class="rv-glyph">{glyph(cs)}</span>
            {cs.coverImage && <img src={cs.coverImage} alt={cs.title} loading="lazy" />}
          </div>
          <div class="card-meta">
            <span class="card-badge">{cs.problemType || cs.industry || 'Business'}</span>
            <span class="card-date">{cs.date}</span>
          </div>
          <h2>{cs.title}</h2>
          <p class="card-snippet">{cs.snippet}</p>
          {cs.revenue && (
            <div class="card-footer">
              <span class="read-more">{t('read.more')} →</span>
              <span class="case-revenue">{cs.revenue}</span>
            </div>
          )}
        </a>
      ))}
      {!leadCase && cases.length === 0 && (
        <div class="empty-state">No case studies yet.</div>
      )}
    </div>

    <PaginationNav
      basePath={`/${lang}/cases/`}
      currentPage={currentPage}
      totalPages={totalPages}
      labels={paginationLabels}
    />
  </div>
</main>

<script is:inline>
  (() => {
    const chips = document.querySelectorAll('[data-filter-chips] .f-chip');
    if (!chips.length) return;
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((other) => other.classList.remove('on'));
        chip.classList.add('on');
        const filter = chip.dataset.filter;
        document.querySelectorAll('[data-paginated-list] [data-category]').forEach((card) => {
          card.style.display = filter === '*' || card.dataset.category === filter ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  .section { padding: 56px 0 88px; }
  .kicker-purple { color: var(--purple); }
  .content-card .card-date { margin-bottom: 0; }
  .content-card .card-meta { margin-bottom: 12px; }
  .case-revenue {
    font-family: var(--display);
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 8px;
    background: var(--paper-2);
    border: 1.5px solid rgba(27,26,23,0.25);
    color: var(--ink-2);
  }
</style>
