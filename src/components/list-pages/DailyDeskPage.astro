---
import type { DailyBrief } from '../../lib/notion';
import PaginationNav from '../PaginationNav.astro';

interface Props {
  lang: 'en' | 'zh' | 'ja';
  t: (key: any) => string;
  leadBrief?: DailyBrief;
  briefs: DailyBrief[];
  currentPage: number;
  totalPages: number;
}

const { lang, t, leadBrief, briefs, currentPage, totalPages } = Astro.props;
const paginationLabels = {
  previous: lang === 'zh' ? '上一页' : lang === 'ja' ? '前へ' : 'Previous',
  next: lang === 'zh' ? '下一页' : lang === 'ja' ? '次へ' : 'Next',
  page: lang === 'zh' ? '页码' : lang === 'ja' ? 'ページ' : 'Page',
  loadMore: lang === 'zh' ? '加载更多' : lang === 'ja' ? 'もっと見る' : 'Load more',
};

function impactClass(impact: string): string {
  const i = (impact || '').toLowerCase();
  if (i.includes('major') || i === 'high') return 'impact-major';
  if (i.includes('notable') || i === 'medium') return 'impact-notable';
  return 'impact-routine';
}

const categories = [...new Set(briefs.map((brief) => brief.category).filter(Boolean))] as string[];

const ui = {
  home: t('nav.home'),
  count: lang === 'zh' ? '每日更新' : lang === 'ja' ? '毎日更新' : 'daily, not weekly',
  lede:
    lang === 'zh'
      ? '每天 5 分钟，掌握真正影响一人公司判断的 AI 动态——按实用性排序，不追热点。'
      : lang === 'ja'
        ? '1日5分。ひとりビジネスの判断に本当に影響するAIの動きだけを、有用性の順で。'
        : 'Track what matters — in 5 minutes a day. Ranked by usefulness to independent builders, not by hype.',
  all: lang === 'zh' ? '全部' : lang === 'ja' ? 'すべて' : 'All',
  editorPick: lang === 'zh' ? '主编推荐' : lang === 'ja' ? '編集部ピック' : 'Editor pick',
  readBrief: lang === 'zh' ? '阅读简报' : lang === 'ja' ? 'ブリーフを読む' : 'Read the brief',
  why: lang === 'zh' ? '为什么重要：' : lang === 'ja' ? 'なぜ重要か：' : 'Why it matters:',
};
---

<header class="page-head c-yellow">
  <div class="container">
    <div class="crumb"><a href={`/${lang}/`}>{ui.home}</a> / {t('nav.daily')}</div>
    <div class="page-title-row">
      <h1>{t('nav.daily')}</h1>
      <span class="count-pill">✦ {ui.count}</span>
    </div>
    <p class="lede">{ui.lede}</p>
  </div>
</header>

{categories.length > 1 && (
  <div class="filter-bar">
    <div class="container">
      <div class="filter-chips" data-filter-chips>
        <button class="f-chip on" data-filter="*">{ui.all}</button>
        {categories.map((category) => (
          <button class="f-chip" data-filter={category}>{category}</button>
        ))}
      </div>
    </div>
  </div>
)}

<main class="section">
  <div class="container">
    {leadBrief && (
      <a class="lead-review lead-brief fade-in" href={`/${lang}/daily/${leadBrief.slug || leadBrief.id}/`}>
        <div class="lead-body">
          <div class="lead-top">
            <span class="card-badge">{leadBrief.category || 'AI'}</span>
            {leadBrief.impact && <span class={`card-badge ${impactClass(leadBrief.impact)}`}>{leadBrief.impact}</span>}
            <span class="lead-date">{leadBrief.date}</span>
          </div>
          <div class="lead-kicker kicker-ink">{ui.editorPick}</div>
          <h2>{leadBrief.title}</h2>
          <p>{leadBrief.snippet}</p>
          {(leadBrief.whyItMatters || leadBrief.commentary) && (
            <div class="lead-why">
              <b>{ui.why}</b> {leadBrief.whyItMatters || leadBrief.commentary}
            </div>
          )}
          <div class="lead-cta">{ui.readBrief} <span>→</span></div>
        </div>
      </a>
    )}

    <div class="card-grid" data-paginated-list>
      {briefs.map((brief, i) => (
        <a
          class="content-card fade-in"
          style={`animation-delay: ${i * 60}ms`}
          href={`/${lang}/daily/${brief.slug || brief.id}/`}
          data-category={brief.category || ''}
        >
          <div class="card-meta">
            <span class="chips-row">
              <span class="card-badge">{brief.category || 'AI'}</span>
              {brief.impact && <span class={`card-badge ${impactClass(brief.impact)}`}>{brief.impact}</span>}
            </span>
            <span class="card-date">{brief.date}</span>
          </div>
          <h2>{brief.title}</h2>
          <p class="card-snippet">{brief.whyItMatters || brief.commentary || brief.snippet}</p>
          <div class="card-footer">
            <span class="read-more">{t('read.more')} →</span>
          </div>
        </a>
      ))}
      {!leadBrief && briefs.length === 0 && (
        <div class="empty-state">No daily briefs yet.</div>
      )}
    </div>

    <PaginationNav
      basePath={`/${lang}/daily/`}
      currentPage={currentPage}
      totalPages={totalPages}
      labels={paginationLabels}
    />
  </div>
</main>

<script is:inline>
  (() => {
    const chips = document.querySelectorAll('[data-filter-chips] .f-chip');
    if (!chips.length) return;
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((other) => other.classList.remove('on'));
        chip.classList.add('on');
        const filter = chip.dataset.filter;
        document.querySelectorAll('[data-paginated-list] [data-category]').forEach((card) => {
          card.style.display = filter === '*' || card.dataset.category === filter ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  .section { padding: 56px 0 88px; }
  .lead-brief { grid-template-columns: 1fr; }
  .lead-top {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .lead-date { font-size: 12.5px; color: var(--ink-3); margin-left: auto; }
  .kicker-ink { color: var(--ink-3); }
  .lead-why {
    margin-top: 18px;
    padding: 14px 18px;
    border-radius: 10px;
    background: rgba(255,212,61,0.18);
    border-left: 3px solid var(--yellow);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 720px;
  }
  .lead-why b { color: var(--ink); font-weight: 700; }
  .chips-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .content-card .card-date { margin-bottom: 0; }
  .content-card .card-meta { margin-bottom: 12px; }
</style>
